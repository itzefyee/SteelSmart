import { NextRequest, NextResponse } from 'next/server';
import { headers } from 'next/headers';

/**
 * EXAMPLE: Zoo Dev Webhook Handler
 * 
 * This is an example implementation of a webhook endpoint for Zoo Dev API.
 * To use this:
 * 1. Rename this file from route.ts.example to route.ts
 * 2. Set up a database to track operation statuses
 * 3. Register this webhook URL with Zoo Dev API
 * 4. Update your CAD generation endpoint to store operation IDs
 * 5. Implement client-side status checking or real-time notifications
 * 
 * Webhook Flow:
 * 1. User initiates CAD generation -> create operation -> store operation_id in DB
 * 2. Return operation_id to client immediately (no polling)
 * 3. Zoo Dev calls this webhook when operation completes
 * 4. Update DB with completion status and model data
 * 5. Client polls your DB or receives real-time update
 */

interface ZooDevWebhookPayload {
  id: string; // operation ID
  type: string; // e.g., "text_to_cad.completed", "text_to_cad.failed"
  data: {
    status: 'completed' | 'failed';
    outputs?: Record<string, any>;
    error?: string;
    created_at: string;
    updated_at: string;
  };
}

export async function POST(request: NextRequest): Promise<NextResponse> {
  try {
    // Verify webhook signature (IMPORTANT for security)
    const headersList = await headers();
    const signature = headersList.get('x-zoo-signature');
    
    if (!signature) {
      console.error('Missing webhook signature');
      return NextResponse.json({ error: 'Unauthorized' }, { status: 401 });
    }

    // TODO: Verify signature using your webhook secret
    // const isValid = verifyWebhookSignature(signature, body, process.env.ZOO_WEBHOOK_SECRET);
    // if (!isValid) {
    //   return NextResponse.json({ error: 'Invalid signature' }, { status: 401 });
    // }

    const payload: ZooDevWebhookPayload = await request.json();
    
    console.log('Received Zoo Dev webhook:', {
      id: payload.id,
      type: payload.type,
      status: payload.data.status
    });

    // Handle different webhook event types
    if (payload.type === 'text_to_cad.completed') {
      await handleTextToCadCompleted(payload);
    } else if (payload.type === 'text_to_cad.failed') {
      await handleTextToCadFailed(payload);
    } else {
      console.log('Unhandled webhook type:', payload.type);
    }

    // Always return 200 to acknowledge receipt
    return NextResponse.json({ received: true });

  } catch (error: any) {
    console.error('Webhook processing error:', error);
    // Still return 200 to prevent retries for malformed requests
    return NextResponse.json({ error: 'Processing failed' }, { status: 200 });
  }
}

